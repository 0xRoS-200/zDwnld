{
  "manifest_version": 3,
  "name": "zDwnld Helper",
  "version": "1.0",
  "description": "Detect downloadable media while browsing and send it to zDwnld.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:6868/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "zDwnld Helper"
  }
}
